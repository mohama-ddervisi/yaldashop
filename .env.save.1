.gallery-thumbs img:hover {
    opacity: 1;
    border-color: #c9a86a;
}

/*==========================
PRODUCT INFO
==========================*/

.product-info {
    display: flex;
    flex-direction: column;
}

.product-brand {
    font-size: 13px;
    color: #999;
    margin-bottom: 8px;
}

#product-name {
    font-size: 26px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 16px;
    line-height: 1.5;
}

.product-description {
    font-size: 14px;
    color: #666;
    line-height: 2;
    margin-bottom: 24px;
}

.product-price {
    font-size: 26px;
    font-weight: 700;
    color: #c9a86a;
    margin-bottom: 14px;
}

.product-stock {
    display: inline-block;
    width: fit-content;
    font-size: 13px;
    background: #e6f6ec;
    color: #1e7c43;
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 28px;
}

/* حالت ناموجود */
.product-stock.out {
    background: #fdeaea;
    color: #b3261e;
}

.quantity-box {
    display: flex;
    align-items: center;
    gap: 16px;
    width: fit-content;
    border: 1px solid #eee;
    border-radius: 30px;
    padding: 6px 10px;
    margin-bottom: 20px;
}

.quantity-box button {
    width: 34px;
    height: 34px;
    border: none;
    border-radius: 50%;
    background: #f6f6f6;
    font-size: 18px;
    cursor: pointer;
    transition: background 0.2s ease;
}

.quantity-box button:hover {
    background: #eee;
}

#quantity {
    font-size: 15px;
    font-weight: 600;
    min-width: 24px;
    text-align: center;
}

.add-cart-btn {
    height: 54px;
    background: #1a1a1a;
    color: #fff;
    border: none;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.1s ease;
}

.add-cart-btn:hover {
    background: #c9a86a;
}

.add-cart-btn:active {
    transform: scale(0.98);
}

/*==========================
TOAST
==========================*/

#toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: #1a1a1a;
    color: #fff;
    padding: 14px 28px;
    border-radius: 30px;
    font-size: 14px;
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s ease;
    z-index: 9999;
}

#toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
}

/*==========================
RESPONSIVE
==========================*/

@media (max-width: 768px) {

    .product-wrapper {
        grid-template-columns: 1fr;
        gap: 24px;
    }

    .product-header {
        padding: 14px 18px;
    }

    .product-page {
        padding: 20px 16px 60px;
    }

    #product-name {
        font-size: 21px;
    }

    .product-price {
        font-size: 22px;
    }

    .add-cart-btn {
        height: 50px;
    }

}
/* ============ عکس اصلی گالری: حذف فضای خالی و اضافه کردن قاب حرفه‌ای ============ */

.gallery-main{
    padding:0 !important;
    border:1px solid #ececec;
    background:#f7f7f7;
    overflow:hidden;
}

.gallery-main img{
    width:100%;
    height:100%;
    object-fit:cover;
}
