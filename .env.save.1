                    products.sort((a,b)=>b.price-a.price);

                break;

                case "name":

                    products.sort((a,b)=>

                        a.name.localeCompare(b.name,"fa")

                    );

                break;

                case "discount":

                    products.sort((a,b)=>

                        (b.discount||0)-(a.discount||0)

                    );

                break;

            }

        }

       const container =
document.getElementById("products-container");

if(!container){
    return;
}

container.innerHTML = "";

        const productsCount =
