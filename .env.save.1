generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  price       Float
  createdAt   DateTime       @default(now())
  brand       String?
  category    String
  image       String?
  slug        String         @unique
  stock       Int            @default(0)
  updatedAt   DateTime       @updatedAt
  discount    Int?
  feature1    String?
  feature2    String?
  oldPrice    Float?
  isActive    Boolean        @default(true)
  soldCount   Int            @default(0)
  orderItems  OrderItem[]
  images      ProductImage[]
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  image     String
  sort      Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id              Int         @id @default(autoincrement())
  fullName        String
  phone           String
  address         String
  total           Int
  status          String      @default("pending")
  createdAt       DateTime    @default(now())
  province        String?
  city            String?
  postalCode      String?
  note            String?
  userId          Int?
  trackingCode    String?
  shippingCompany String?
paymentRef      String?
paymentTrackId  String?
authority       String?
paidAt          DateTime?
  user            User?       @relation(fields: [userId], references: [id])
